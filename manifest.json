{
  "manifest_version": 3,
  "name": "Chrome-404",
  "version": "0.2.0",
  "description": "Sampler-style FX buses for any tab's audio.",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "sidePanel", "storage", "activeTab", "tabs", "contextMenus"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Chrome-404: capture this tab (Alt+Shift+4)"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+4" },
      "description": "Capture the current tab"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  }
}
